<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0e11"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/setup_title"
        android:textColor="#eaecef"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/setup_hint"
        android:textColor="#848e9c"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/serverUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:background="#12161c"
        android:hint="@string/setup_url_hint"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textColor="#eaecef"
        android:textColorHint="#5b6570"
        android:textSize="15sp" />

    <Button
        android:id="@+id/openBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="#f0b90b"
        android:text="@string/setup_open"
        android:textColor="#0b0e11"
        android:textSize="15sp" />

    <Button
        android:id="@+id/localBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="#1e2329"
        android:text="@string/setup_local"
        android:textColor="#eaecef"
        android:textSize="14sp" />
</LinearLayout>
